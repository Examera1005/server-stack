# Immich Environment Variables Configuration Template
# Copy this file to .env and adjust values before launching

# The location where your uploaded photo/video files are stored on the host
UPLOAD_LOCATION=/mnt/hdd/data/photos

# The location where database files will be persisted
DB_DATA_LOCATION=./postgres

# Timezone setting (e.g. Europe/Paris)
# TZ=Europe/Paris

# Immich version tag
IMMICH_VERSION=v3

# Connection secret for postgres. CHANGE THIS TO A SECURE RANDOM PASSWORD!
# Use only alphanumeric characters (A-Za-z0-9)
DB_PASSWORD=your_secure_postgres_password_here

# Database credentials
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
